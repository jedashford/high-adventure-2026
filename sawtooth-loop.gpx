<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Sawtooth High Adventure Trail Atlas" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Alice-Toxaway Loop (Lakeside 14th, Aug 2026)</name>
<desc>18.6 mi clockwise from Tin Cup TH. Geometry: OpenStreetMap (ODbL). Not a substitute for a paper map.</desc></metadata>
<wpt lat="43.98441" lon="-114.87189"><name>Tin Cup (Pettit Lake) Trailhead</name><desc>Start/finish. $10/vehicle/day cash. Self-issue permit box.</desc></wpt>
<wpt lat="43.93824" lon="-114.95647"><name>Twin Lakes camp (night 1)</name><desc>Sites on forested east side; quieter than Alice.</desc></wpt>
<wpt lat="43.9403" lon="-114.9425"><name>Alice Lake peninsula (night 1 fallback)</name><desc>Big-group peninsula; hang all food.</desc></wpt>
<wpt lat="43.944" lon="-114.961"><name>Snowyside Pass 9,415 ft</name><desc>High point. Cross before 11 AM. Exposed.</desc></wpt>
<wpt lat="43.9633" lon="-114.9739"><name>Toxaway NW junction - TURN RIGHT</name><desc>3-way junction; wrong fork goes to Edna. Right along the lake.</desc></wpt>
<wpt lat="43.97" lon="-114.956"><name>Toxaway north shore camp (night 2)</name><desc>Best sites toward the end of the lake, below the trail.</desc></wpt>
<wpt lat="43.9769" lon="-114.95932"><name>Edith Lake (day hike)</name><desc>1.0 mi from camp, +490 ft. Not a camp.</desc></wpt>
<wpt lat="43.97276" lon="-114.96955"><name>Sand Mountain Pass 9,282 ft (day hike)</name><desc>2.0 mi from NW junction, +890 ft.</desc></wpt>
<wpt lat="43.97926" lon="-114.9317"><name>Farley Lake (lunch, not camp)</name><desc>Limited sites; waterfalls below.</desc></wpt>
<wpt lat="43.9956" lon="-114.8934"><name>McDonald junction - TURN RIGHT</name><desc>Right onto Pettit Lake Cutoff for the cars.</desc></wpt>
<wpt lat="44.0055" lon="-114.87"><name>Yellow Belly Lake NE cove (night 3 option)</name><desc>Outside wilderness; dispersed sites; swimming.</desc></wpt>
<wpt lat="43.948" lon="-114.93"><name>Footbridge - NO RAILINGS (approx)</name><desc>Crossing 5 of 6. One at a time, no stopping mid-span.</desc></wpt>
<trk><name>Alice-Toxaway Loop (valley route)</name><trkseg>
