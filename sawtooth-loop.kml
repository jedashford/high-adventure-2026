<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
<name>Alice-Toxaway Loop — Sawtooth High Adventure 2026</name>
<Style id="route"><LineStyle><color>ff1f53b4</color><width>4</width></LineStyle></Style>
<Style id="spur"><LineStyle><color>ff3b6d8a</color><width>3</width></LineStyle></Style>
<Placemark><name>Tin Cup (Pettit Lake) Trailhead</name><description>Start/finish. $10/vehicle/day cash. Self-issue permit box.</description><Point><coordinates>-114.87189,43.98441,0</coordinates></Point></Placemark>
<Placemark><name>Twin Lakes camp (night 1)</name><description>Sites on forested east side; quieter than Alice.</description><Point><coordinates>-114.95647,43.93824,0</coordinates></Point></Placemark>
<Placemark><name>Alice Lake peninsula (night 1 fallback)</name><description>Big-group peninsula; hang all food.</description><Point><coordinates>-114.9425,43.9403,0</coordinates></Point></Placemark>
<Placemark><name>Snowyside Pass 9,415 ft</name><description>High point. Cross before 11 AM. Exposed.</description><Point><coordinates>-114.961,43.944,0</coordinates></Point></Placemark>
<Placemark><name>Toxaway NW junction - TURN RIGHT</name><description>3-way junction; wrong fork goes to Edna. Right along the lake.</description><Point><coordinates>-114.9739,43.9633,0</coordinates></Point></Placemark>
<Placemark><name>Toxaway north shore camp (night 2)</name><description>Best sites toward the end of the lake, below the trail.</description><Point><coordinates>-114.956,43.97,0</coordinates></Point></Placemark>
<Placemark><name>Edith Lake (day hike)</name><description>1.0 mi from camp, +490 ft. Not a camp.</description><Point><coordinates>-114.95932,43.9769,0</coordinates></Point></Placemark>
<Placemark><name>Sand Mountain Pass 9,282 ft (day hike)</name><description>2.0 mi from NW junction, +890 ft.</description><Point><coordinates>-114.96955,43.97276,0</coordinates></Point></Placemark>
<Placemark><name>Farley Lake (lunch, not camp)</name><description>Limited sites; waterfalls below.</description><Point><coordinates>-114.9317,43.97926,0</coordinates></Point></Placemark>
<Placemark><name>McDonald junction - TURN RIGHT</name><description>Right onto Pettit Lake Cutoff for the cars.</description><Point><coordinates>-114.8934,43.9956,0</coordinates></Point></Placemark>
<Placemark><name>Yellow Belly Lake NE cove (night 3 option)</name><description>Outside wilderness; dispersed sites; swimming.</description><Point><coordinates>-114.87,44.0055,0</coordinates></Point></Placemark>
<Placemark><name>Footbridge - NO RAILINGS (approx)</name><description>Crossing 5 of 6. One at a time, no stopping mid-span.</description><Point><coordinates>-114.93,43.948,0</coordinates></Point></Placemark>
<Placemark><name>Main loop (18.6 mi)</name><styleUrl>#route</styleUrl><LineString><tessellate>1</tessellate><coordinates>
